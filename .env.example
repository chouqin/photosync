# Azure Blob Storage
AZURE_STORAGE_ACCOUNT=yourstorageaccount
AZURE_STORAGE_KEY=yourstoragekey
AZURE_STORAGE_CONTAINER=photos
AZURE_STORAGE_TIER=Cool

# Security
SECRET_KEY=change-me-to-a-256-bit-random-string
PHOTOSYNC_PASSWORD=change-me-to-a-strong-password

# Thumbnails
THUMBNAIL_SIZES=256,512,1024

# Upload
MAX_UPLOAD_SIZE_MB=50
